{
  "name": "@mieru/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env --conditions=development src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx --env-file-if-exists=../../.env scripts/migrate.ts",
    "storage:gc": "tsx --env-file-if-exists=../../.env scripts/storage-gc.ts",
    "fixtures": "tsx scripts/make-fixtures.ts",
    "admin": "tsx --env-file-if-exists=../../.env scripts/admin.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.8",
    "@mieru/shared": "*",
    "argon2": "^0.45.1",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.2.15",
    "mysql2": "^3.24.6",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  }
}
